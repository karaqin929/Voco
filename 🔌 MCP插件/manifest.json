{
  "manifest_version": 3,
  "name": "LingoTrace — 口语日报自动同步",
  "version": "1.0",
  "description": "ChatGPT 口语练习日报一键同步到 LingoTrace",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:8765/*", "https://chatgpt.com/*", "https://chat.openai.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LingoTrace"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "icons": {
    "128": "icon.svg"
  }
}
